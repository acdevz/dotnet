@model IEnumerable<LifelineHospital.DAL.Models.Appointment>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AppointmentId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PatientId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AppointmentDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.AppointmentId)
                </td>
                <td>
                    @Html.DisplayFor(model => item.PatientId)
                </td>
                <td>
                    @Html.DisplayFor(model => item.AppointmentDate)
                </td>
                <td>
                    <a asp-controller="Patient" asp-action="Details" asp-route-id="@item.AppointmentId">Patient Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
