@model OrderApp.Models.Orders.CreateOrderViewModel

@{
    ViewData["Title"] = "Create Order";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none">
                ← Back to Orders
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h1 class="h3 mb-2">Create Order</h1>

                <p class="text-muted">
                    Enter the customer details. The initial
                    <strong>"Order Created"</strong> status will be generated automatically.
                </p>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label">
                        </label>

                        <input asp-for="CustomerName" class="form-control" autocomplete="name" autofocus />

                        <span asp-validation-for="CustomerName" class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Create Order
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>
        </div>
